{
  "name": "jobquery",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app that finds jobs that fit you, writes your applications in your own voice with your own AI key, and tracks everything you applied to.",
  "main": "./out/main/index.js",
  "author": "Nuja1337",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "vite --config vite.demo.config.mts",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "dev.jobquery.app",
    "productName": "JobQuery",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/smoke/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nuja1337",
        "repo": "jobquery-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "electron-updater": "^6.8.11",
    "html-to-text": "^10.0.1",
    "mammoth": "^1.13.0",
    "openai": "^7.45.1",
    "playwright-core": "^1.64.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
